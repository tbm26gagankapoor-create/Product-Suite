{
  "name": "infinia-backend",
  "version": "1.0.0",
  "description": "Backend API for Infinia Products",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:seed": "tsx src/scripts/seed-db.ts",
    "db:seed:pg": "tsx src/scripts/seed-postgres.ts",
    "db:migrate": "tsx src/scripts/migrate-to-mongodb.ts",
    "db:migrate:dual": "tsx src/scripts/migrate-to-dual-db.ts",
    "db:migrate:dual:dry-run": "DRY_RUN=true tsx src/scripts/migrate-to-dual-db.ts",
    "db:migrate:dual:verify": "VERIFY_ONLY=true tsx src/scripts/migrate-to-dual-db.ts",
    "db:migrate:complete-mongo": "tsx src/scripts/complete-mongodb-migration.ts",
    "db:migrate:pg": "node-pg-migrate up",
    "db:migrate:pg:down": "node-pg-migrate down",
    "db:migrate:pg:create": "node-pg-migrate create",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration"
  },
  "dependencies": {
    "@types/nodemailer": "^7.0.9",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.1.5",
    "morgan": "^1.10.0",
    "node-pg-migrate": "^7.5.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.11.3",
    "resend": "^6.9.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^11.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
