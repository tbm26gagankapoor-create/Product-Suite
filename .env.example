# Infinia Products - Environment Variables

# ================================
# DATABASE CONFIGURATION
# ================================

# MongoDB (Required - Use MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/infinia_dev?retryWrites=true&w=majority

# PostgreSQL (Required - For system data)
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://infinia:your_secure_password_here@postgres:5432/infinia_system

# ================================
# SECURITY (Required)
# ================================

# JWT Secret (REQUIRED - Generate with: openssl rand -base64 64)
JWT_SECRET=your_jwt_secret_min_32_characters_here

# Encryption Key (REQUIRED - For API key encryption)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_encryption_key_64_hex_characters

# ================================
# SERVER CONFIGURATION
# ================================

# CORS Origin (Update for production)
CORS_ORIGIN=http://localhost:3000

# ================================
# EMAIL (Optional)
# ================================

# Resend API Key (for email notifications)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# ================================
# OAUTH PROVIDERS (Optional)
# ================================

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# ================================
# AI PROVIDERS (Configured via Admin Portal)
# ================================
# AI providers are configured in the admin portal
# No environment variables needed here
