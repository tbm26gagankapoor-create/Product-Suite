# ===========================================
# Docker Compose Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# General
# ===========================================
NODE_ENV=production
JWT_SECRET=your-super-secret-jwt-key-change-in-production-32chars
FRONTEND_URL=http://localhost:8080

# ===========================================
# PostgreSQL
# ===========================================
POSTGRES_USER=infinia
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=infinia
POSTGRES_PORT=5432

# ===========================================
# MongoDB
# ===========================================
MONGO_USER=infinia
MONGO_PASSWORD=your-mongo-password
MONGO_DB=infinia
MONGO_PORT=27017

# ===========================================
# Service Ports (optional - defaults shown)
# ===========================================
FRONTEND_PORT=8080
ADMIN_PORT=8084
API_PORT=3000
ADMINER_PORT=8081
MONGO_EXPRESS_PORT=8083
OPENFGA_HTTP_PORT=8088
OPENFGA_GRPC_PORT=8089
OPENFGA_PLAYGROUND_PORT=3002

# ===========================================
# OpenFGA (auto-generated on first run)
# ===========================================
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=

# ===========================================
# Microsoft Entra ID (Tenant SSO)
# ===========================================
# Multi-tenant SaaS application for user authentication
#
# Setup Instructions:
# 1. Go to Azure Portal > Microsoft Entra ID > App registrations
# 2. Create a new registration:
#    - Name: "Your App Name"
#    - Supported account types: "Accounts in any organizational directory (Multitenant)"
#    - Redirect URI (Web): http://localhost:8080/auth/callback
#
# 3. Configure API permissions (Microsoft Graph):
#    - openid, profile, email, User.Read (Delegated)
#    - Directory.Read.All (Delegated) - For checking Azure AD admin roles
#
# 4. Create a Client Secret in "Certificates & secrets"
#
ENTRA_CLIENT_ID=your-entra-client-id
ENTRA_CLIENT_SECRET=your-entra-client-secret
ENTRA_TENANT_ID=common
ENTRA_REDIRECT_URI=http://localhost:8080/auth/callback

# ===========================================
# Microsoft Entra ID (Admin Portal SSO)
# ===========================================
# Separate app registration for SaaS platform admin portal
# Only members of the specified Entra ID group can access
#
# Setup:
# 1. Create App Registration in Azure Portal
# 2. Add API permissions: openid, profile, email, User.Read, GroupMember.Read.All
# 3. Create a Security Group in Entra ID for admins
# 4. Add admin users to the group
# 5. Copy the Group Object ID below
#
ENTRA_ADMIN_CLIENT_ID=your-admin-entra-client-id
ENTRA_ADMIN_CLIENT_SECRET=your-admin-entra-client-secret
ENTRA_ADMIN_TENANT_ID=your-organization-tenant-id
ENTRA_ADMIN_REDIRECT_URI=http://localhost:8084/auth/callback
# Required: Entra ID Security Group Object ID for admin access
ENTRA_ADMIN_GROUP_ID=your-admin-group-object-id
# Fallback: Allowed domains if no group configured (comma-separated)
ENTRA_ADMIN_ALLOWED_DOMAINS=

# ===========================================
# Web Search Providers (for AI Research)
# ===========================================
# Configure one or more search providers to enable
# competitive research in the product creation wizard.
# API keys can also be configured via the Admin Portal.
#
# TAVILY_API_KEY=tvly-your-tavily-api-key
# SERPER_API_KEY=your-serper-api-key
# BRAVE_SEARCH_API_KEY=your-brave-search-api-key
